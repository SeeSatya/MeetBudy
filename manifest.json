{
  "manifest_version": 3,
  "name": "Meet Budy",
  "version": "1.0.0",
  "description": "Record Google Meet screen shares with all participant audio. Resilient WebRTC stream capture saved locally.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "webm_metadata.js",
        "muxer.js",
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Meet Recorder",
    "default_icon": {
      "16": "icons/icon16-inactive.png",
      "48": "icons/icon48-inactive.png",
      "128": "icons/icon128-inactive.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "background_image.png",
        "muxer.js",
        "vendor/ffmpeg/ffmpeg-core.js",
        "vendor/ffmpeg/ffmpeg-core.wasm"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
